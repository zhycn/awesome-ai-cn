{
  "name": "awesome-ai-cn",
  "version": "0.1.0",
  "private": true,
  "description": "中文 AI 资源精选清单",
  "scripts": {
    "build": "node scripts/build.ts",
    "build:check": "node scripts/build.ts --check",
    "validate": "node scripts/validate.ts",
    "check:links": "node scripts/check_links.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{md,ts}\"",
    "format:check": "prettier --check \"**/*.{md,ts}\"",
    "check": "npm run validate && npm run build:check && npm run format:check && npm run typecheck",
    "scaffold": "node scripts/scaffold.ts",
    "test": "node --test tests/scaffold.test.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
