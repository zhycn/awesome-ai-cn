{
  "name": "awesome-ai-cn",
  "version": "0.1.0",
  "private": true,
  "description": "中文 AI 资源精选清单",
  "scripts": {
    "build": "node scripts/build.ts",
    "build:check": "node scripts/build.ts --check",
    "validate": "node scripts/validate.ts",
    "check:links": "node scripts/check_links.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.md\"",
    "format:check": "prettier --check \"**/*.md\"",
    "check": "npm run validate && npm run build:check && npm run format:check && npm run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "@types/node": "^24.10.1"
  },
  "type": "module"
}
