{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhycn/awesome-ai-cn/config/schema.json",
  "title": "Awesome AI CN — 条目规范",
  "description": "data/<category-id>.json 是一个条目数组。validate.py 以本文件中的 required、enum、maxLength 等约束为准，改规范即改本文件。",
  "type": "array",
  "items": {
    "$ref": "#/$defs/item"
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "url",
        "desc",
        "pricing",
        "status",
        "added"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64,
          "description": "全局唯一 slug，小写连字符；创建后不再修改（外部可能引用）。"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "展示名，保留官方大小写。"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$",
          "maxLength": 300,
          "description": "主入口链接，必须可直达；不要放带追踪参数的短链。"
        },
        "desc": {
          "type": "string",
          "minLength": 6,
          "maxLength": 60,
          "description": "一句话中文简介，陈述句，不加句号，不写营销词。"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "国产",
              "多模态",
              "语音",
              "图像",
              "视频",
              "代码",
              "知识库",
              "工作流",
              "私有化",
              "企业",
              "协议",
              "评测"
            ]
          },
          "description": "1–3 个细分标签，只能取受控词表中的值；可从 pricing/lang 推出的信息不要做成标签。"
        },
        "vendor": {
          "type": "string",
          "maxLength": 40,
          "description": "归属机构或个人，未知可省略。"
        },
        "lang": {
          "enum": [
            "zh",
            "en",
            "multi"
          ],
          "default": "zh",
          "description": "中文友好度：zh 原生中文，multi 有中文界面/文档，en 仅英文。"
        },
        "pricing": {
          "enum": [
            "free",
            "freemium",
            "paid",
            "open-source"
          ],
          "description": "价格档位，不追踪具体金额。"
        },
        "status": {
          "enum": [
            "active",
            "beta",
            "deprecated",
            "archived"
          ],
          "description": "维护状态；deprecated 与 archived 默认不在 README 展示，除非显式保留。"
        },
        "featured": {
          "type": "boolean",
          "default": false,
          "description": "是否加星标强调（不改变顺序）；同一主题内最多 3 条。"
        },
        "added": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "收录日期，ISO 格式 YYYY-MM-DD。"
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repo": {
              "type": "string",
              "pattern": "^https?://[^\\s]+$"
            },
            "docs": {
              "type": "string",
              "pattern": "^https?://[^\\s]+$"
            }
          },
          "description": "可选独立入口；README 中默认只展示 url。"
        }
      }
    }
  }
}
